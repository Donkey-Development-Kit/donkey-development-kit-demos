# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
#
#     cp .env.example .env.local
#
# NEVER put a real value in this file. It is tracked. `make scan` fails the
# repo if a placeholder here is replaced with something that looks real.
#
# A shell `export` always wins over a file value, so you can also skip the file
# entirely and export these in your session.

# ---------------------------------------------------------------------------
# Governed LLM proxy (the data plane). Needed ONLY for the live demos.
# Every offline demo runs against `donkey mock` and needs none of this.
#
# The proxy authenticates on a client_id/client_secret HEADER PAIR — it is not
# a bearer token, and it is a different credential from any Anypoint
# control-plane connected app.
# ---------------------------------------------------------------------------

# Note the trailing slash and the absence of /v1 — the ingress URL is
# https://<ingress-host>/<instance>/ and the OpenAI SDK appends /responses.
DONKEY_LLM_PROXY_URL=https://REPLACE-ME.example.invalid/REPLACE-ME/
DONKEY_LLM_PROXY_CLIENT_ID=REPLACE-ME
DONKEY_LLM_PROXY_CLIENT_SECRET=REPLACE-ME

# ---------------------------------------------------------------------------
# Demo harness knobs (safe to commit as-is; none of these are secrets).
# ---------------------------------------------------------------------------

# Model id the live demos ask for. Must be one your proxy actually routes.
DEMO_MODEL=gpt-4o

# Where `--target mock` points. Change only if 8080 is taken.
DEMO_MOCK_URL=http://127.0.0.1:8080

# Output redaction. ON by default: every demo masks hostnames, credentials and
# infrastructure identifiers before printing, so a screen recording is safe.
# Set to 0 ONLY when debugging privately, never while sharing your screen.
DEMO_REDACT=1
